{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.8.31",
        "${HOME}/notas"
      ]
    },
    "google-calendar": {
      "command": "npx",
      "args": [
        "-y",
        "@cocal/google-calendar-mcp@2.8.1"
      ],
      "env": {
        "GOOGLE_OAUTH_CREDENTIALS": "${HOME}/.config/tony/google-calendar-credentials.json"
      }
    }
  },
  "native": [
    "read_skill",
    "run_subagent"
  ],
  "confirm": [
    "filesystem.write_file",
    "filesystem.edit_file",
    "filesystem.move_file",
    "google-calendar.create-event",
    "google-calendar.update-event",
    "google-calendar.delete-event"
  ]
}
