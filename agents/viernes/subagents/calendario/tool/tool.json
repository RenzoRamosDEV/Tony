{
  "mcpServers": {
    "google-calendar": {
      "command": "npx",
      "args": [
        "-y",
        "@cocal/google-calendar-mcp@2.8.1"
      ],
      "env": {
        "GOOGLE_OAUTH_CREDENTIALS": "${HOME}/.config/tony/google-calendar-credentials.json"
      }
    }
  },
  "confirm": [
    "google-calendar.create-event",
    "google-calendar.update-event",
    "google-calendar.delete-event"
  ]
}
