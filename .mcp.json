{
  "mcpServers": {
    "v0": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://v0.app/api/mcp"
      ]
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide"
      ]
    }
  }
}
