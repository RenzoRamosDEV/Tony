{
  "mcp": {
    "v0": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "mcp-remote",
        "https://v0.app/api/mcp"
      ]
    },
    "atlassian": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "serena": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide"
      ]
    }
  }
}